    {
      "name": "metrics.submit",
      "description": "提交同一策略和任务身份内的业务窗口；SLO会话可据此保留或回退策略",
      "inputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "window_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "boot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "policy_revision": {
            "type": "integer",
            "minimum": 0
          },
          "workload_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "enum": [
              "wrk.reported",
              "wrk2.hdr.aligned",
              "wrk2.hdr.window"
            ]
          },
          "source_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "start_monotonic": {
            "type": "number",
            "minimum": 0
          },
          "end_monotonic": {
            "type": "number",
            "minimum": 0
          },
          "frontend_p99_ms": {
            "type": "number",
            "minimum": 0
          },
          "completed_requests": {
            "type": "integer",
            "minimum": 1
          },
          "request_errors": {
            "type": "integer",
            "minimum": 0
          },
          "offered_rps": {
            "type": "number",
            "minimum": 1
          },
          "background_eps": {
            "type": "number",
            "minimum": 0
          },
          "background_covered_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "schema_version",
          "window_id",
          "profile_id",
          "boot_id",
          "policy_revision",
          "workload_key",
          "source",
          "source_sha256",
          "start_monotonic",
          "end_monotonic",
          "frontend_p99_ms",
          "completed_requests",
          "request_errors",
          "offered_rps",
          "background_eps",
          "background_covered_seconds"
        ],
        "additionalProperties": false
      },
      "mutates": true
    },
