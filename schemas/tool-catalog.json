    {
      "name": "policy.evaluate",
      "description": "评估实际业务窗口的延迟、吞吐与后台约束；缺少指标时不作收益判定",
      "inputSchema": {
        "type": "object",
        "properties": {
          "before": {
            "type": "object",
            "properties": {
              "frontend_p99_ms": {
                "type": "number",
                "minimum": 0
              },
              "frontend_rps": {
                "type": "number",
                "minimum": 0
              },
              "background_eps": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "after": {
            "type": "object",
            "properties": {
              "frontend_p99_ms": {
                "type": "number",
                "minimum": 0
              },
              "frontend_rps": {
                "type": "number",
                "minimum": 0
              },
              "background_eps": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "goals": {
            "type": "object",
            "properties": {
              "max_p99_ms": {
                "type": "number",
                "minimum": 0.001
              },
              "min_frontend_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "min_background_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "max_p99_ms",
              "min_frontend_fraction",
              "min_background_fraction"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "before",
          "after",
          "goals"
        ],
        "additionalProperties": false
      },
      "mutates": false
    },
    {
