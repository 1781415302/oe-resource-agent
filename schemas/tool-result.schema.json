{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openEuler Agent tool result v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": ["string", "integer", "null"]},
    "tool": {"type": "string"},
    "ok": {"type": "boolean"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "data": {},
    "error": {
      "type": "object",
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}},
      "required": ["code", "message", "details"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "request_id", "tool", "ok", "elapsed_seconds"],
  "additionalProperties": false,
  "oneOf": [
    {"properties": {"ok": {"const": true}}, "required": ["data"], "not": {"required": ["error"]}},
    {"properties": {"ok": {"const": false}}, "required": ["error"], "not": {"required": ["data"]}}
  ]
}
