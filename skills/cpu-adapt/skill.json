{
  "schema_version": 1,
  "id": "cpu-adapt",
  "version": "0.1.3",
  "description": "观察服务与后台负载，以确认窗口和最短驻留时间选择默认调度或可配置 SCX",
  "entry_tool": "agent.run",
  "required_tools": [
    "system.capabilities",
    "workload.observe",
    "policy.validate",
    "policy.apply",
    "policy.rollback"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "profile": {
        "type": "string",
        "enum": [
          "nginx-cpu"
        ]
      },
      "duration_seconds": {
        "type": "number",
        "minimum": 1,
        "maximum": 43200
      },
      "dry_run": {
        "type": "boolean"
      }
    },
    "required": [
      "profile",
      "duration_seconds"
    ],
    "additionalProperties": false
  },
  "acceptance": [
    "真实动作有参数回读和日志",
    "退出后恢复默认调度",
    "观测不足时不执行新策略",
    "不将CPU指标当作请求p99"
  ],
  "status": "behavior-routing skill verified; business feedback uses the separate nginx-slo session"
}
