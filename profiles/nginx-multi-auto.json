{
  "schema_version": 1,
  "name": "nginx-multi-resource-auto",
  "selectors": [
    {"role": "latency", "comm": ["nginx"]},
    {"role": "batch", "comm": ["sysbench"]}
  ],
  "sample_seconds": 1.0,
  "lease_seconds": 15,
  "controller_cpu": 2,
  "policy": {
    "latency_slice_us": 1000,
    "balanced_slice_us": 4000,
    "batch_slice_us": 20000,
    "confirmations": 2,
    "residence_seconds": 3.0,
    "batch_active_cpu_percent": 10.0,
    "latency_switches_per_sec": 20.0,
    "latency_wait_fraction": 0.05,
    "wakeup_preempt": true
  },
  "plugins": {
    "enabled": true,
    "cgroup_enabled": true,
    "latency_group": "auto_latency",
    "batch_group": "auto_batch",
    "latency_shares": 4096,
    "batch_shares": 1024,
    "ebpf_enabled": true,
    "monitor_port": 18095,
    "drop_threshold_pps": 20.0,
    "drop_hold_windows": 2,
    "lsm_audit_enabled": true
  },
  "calibration_status": "validated_multi_resource_auto_orchestration",
  "performance_claim": null
}
